rules_version = '2';
service cloud.firestore {
  match /databases/{databaseId}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
  
    function isUser(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    match /questionnaires/{questionnaireId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /users/{userId} {

      allow read: if isUser(userId);

      allow create: if isUser(userId);

      allow update: if isUser(userId);
    }

    match /users/{userId}/{collectionName}/{documentId} {

      // documentSnapshots is server-only snapshot history and
      // healthProviderTokens holds OAuth secrets; both must stay server-only.
      // healthProviderConnections is server-written status the client may read
      // (handled by the dedicated rule below), so it is excluded here too.
      allow read, write: if isUser(userId)
        && collectionName != "documentSnapshots"
        && collectionName != "healthProviderTokens"
        && collectionName != "healthProviderConnections";
    }

    // Health-provider connection status: server writes, client reads only.
    match /users/{userId}/healthProviderConnections/{documentId} {
      allow read: if isUser(userId);
      allow write: if false;
    }
    
    match /feedback/{uuid} {
      allow create: if isAuthenticated() 
                    && request.resource.data.accountId == request.auth.uid;
      
      allow update, delete: if false;
      
      allow read: if false;
    }
  }
}