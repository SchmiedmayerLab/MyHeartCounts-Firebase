rules_version = '2';
service cloud.firestore {
  match /databases/{databaseId}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
  
    function isUser(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    match /questionnaires/{questionnaireId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /users/{userId} {

      allow read: if isUser(userId);

      allow create: if isUser(userId);

      allow update: if isUser(userId);
    }

    // Server-only snapshot history.
    match /users/{userId}/documentSnapshots/{snapshotId} {

      allow read, write: if false;
    }

    match /users/{userId}/{collectionName}/{documentId} {

      allow read: if isUser(userId) && collectionName != "documentSnapshots";

      allow write: if isUser(userId) && collectionName != "documentSnapshots";
    }
    
    match /feedback/{uuid} {
      allow create: if isAuthenticated() 
                    && request.resource.data.accountId == request.auth.uid;
      
      allow update, delete: if false;
      
      allow read: if false;
    }
  }
}