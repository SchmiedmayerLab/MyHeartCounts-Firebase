{
  "name": "functions",
  "version": "4.0.6",
  "description": "Cloud Functions for Firebase",
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "eslint src --max-warnings=0",
    "build": "tsc --noEmitOnError false || true",
    "clean": "if [ -f tsconfig.tsbuildinfo ]; then rm tsconfig.tsbuildinfo; fi && if [ -d lib ]; then rm -r lib; fi",
    "test": "env TZ=UTC c8 mocha --reporter-option maxDiffSize=0",
    "test:ci": "c8 npm run test",
    "test:emulators": "env EMULATORS_ACTIVE=true FUNCTIONS_EMULATOR=true npm run test",
    "test:regenerate": "env REGENERATE_VALUES=true npm run test",
    "serve": "firebase emulators:start --only auth,firestore,functions,storage",
    "serve:watch": "npm run build -- --watch | npm run serve",
    "serve:seeded": "firebase emulators:exec --only auth,firestore,functions,storage --ui \"curl -X POST http://127.0.0.1:5001/myheart-counts-development/us-central1/customSeed -H 'Content-Type: application/json' -d @data/debug/users.json && if [ -z \\$IN_DOCKER_CONTAINER ]; then read -r; else sleep infinity; fi\"",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "d3": "^7.9.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "fzstd": "^0.1.1",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@stanfordspezi/spezi-web-configurations": "^0.7.0",
    "@types/chai": "^5.2.3",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.4",
    "@types/mocha": "^10.0.7",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "eslint-config-google": "^0.14",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase-functions-test": "^3.5.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "fast-xml-parser": "^5.3.4",
    "undici": "^6.22.1",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.4",
    "http-proxy-agent": "^7.0.2"
  }
}