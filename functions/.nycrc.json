{
  "all": true,
  "check-coverage": true,
  "reporter": ["text", "lcov"],
  "extension": [".js", ".cjs", ".mjs"],
  "include": ["lib"],
  "exclude": [
    "lib/tests",
    "**/*.test.js",
    "**/*.no-coverage.js",
    "**/*.mock.js"
  ],
  "branches": 70,
  "lines": 70,
  "functions": 70,
  "statements": 70
}
